{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>canonical/data-platform//renovate_presets/base.json5"],
  // Between 1AM and 6:59AM, first Friday of the month
  schedule: ["* 1-6 1-7 * 5"],
  ignoreDeps: ["ubuntu"],
  baseBranchPatterns: ["/^3\\..*\\/edge$/"],
  enabledManagers: ["github-actions", "custom.regex"],
  commitMessagePrefix: "[RENOVATE] ",
  lockFileMaintenance: { enabled: false },
  customManagers: [
    {
      description: "Match Maven JARs in rockcraft.yaml with `# renovate: datasource=<ds> depName=<name>`",
      customType: "regex",
      managerFilePatterns: ["**/rockcraft.yaml"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s\\n]+)\\n\\s+(?<depType>\\w+_VERSION)='(?<currentValue>[^']+)'",
      ],
    },
    {
      description: "Match GH releases JARs in rockcraft.yaml with `# renovate: datasource=<ds> depName=<name> extractVersion=<pattern>`",
      customType: "regex",
      managerFilePatterns: ["**/rockcraft.yaml"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s+extractVersion=(?<extractVersion>[^\\n]+)\\n\\s+\\w+_VERSION='(?<currentValue>[^']+)'",
      ],
    },
    {
      description: "Match Python packages in rockcraft.yaml with `# renovate: datasource=pypi`",
      customType: "regex",
      managerFilePatterns: ["**/rockcraft.yaml"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=pypi\\n\\s+pip install[^\\n]+ (?<depName>[^=\\s]+)==(?<currentValue>[^\\s\\n]+)",
      ],
      datasourceTemplate: "pypi",
    },
    {
      description: "Update Spark tarball version in rockcraft.yaml",
      customType: "regex",
      managerFilePatterns: ["**/rockcraft.yaml"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>[^\\s]+)\\s+depType=(?<depType>[^\\s\\n]+)\\n\\s+source:\\s*https://github\\.com/[^\\s]+/releases/download/(?<currentValue>spark-\\d+\\.\\d+\\.\\d+-ubuntu\\d+)/[^\\s]+\\.tgz",
      ],
      datasourceTemplate: "github-releases",
      versioningTemplate: "regex:^spark-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ubuntu(?<build>\\d+)$",
    },
  ],
  packageRules: [
    {
      description: "Combine all rockcraft.yaml dependencies into a single PR",
      matchFileNames: ["**/rockcraft.yaml"],
      groupName: "rockcraft dependencies",
      groupSlug: "rockcraft-deps",
    },
    {
      description: "Disallow major updates for jmx_prometheus_javaagent",
      matchDepNames: ["io.prometheus.jmx:jmx_prometheus_javaagent"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Only allow minor and patch updates for central-uploader deps",
      matchDatasources: ["github-releases"],
      matchDepNames: ["canonical/central-uploader"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Only allow patch updates for spark tarball source",
      matchDepTypes: ["spark-source"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
  ],
}
