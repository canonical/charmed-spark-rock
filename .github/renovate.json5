{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>canonical/data-platform//renovate_presets/base.json5"],
  // Between 1AM and 6:59AM, first Friday of the month
  schedule: ["* 1-6 1-7 * 5"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 1-6 1-7 * 5"],
  },
  ignoreDeps: ["ubuntu"],
  baseBranchPatterns: ["/^3\\..*\\/edge$/"],
  customManagers: [
    {
      // Matches shell version variables annotated with:
      //   # renovate: datasource=<ds> depName=<name>
      // Used for Maven JARs in rockcraft.yaml overlay-scripts
      customType: "regex",
      managerFilePatterns: ["/rockcraft\\.yaml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s\\n]+)\\n\\s+(?<depType>\\w+_VERSION)='(?<currentValue>[^']+)'",
      ],
    },
    {
      // Matches shell version variables annotated with:
      //   # renovate: datasource=<ds> depName=<name> extractVersion=<pattern>
      // Used for GitHub Releases JARs (e.g. canonical/central-uploader) in rockcraft.yaml
      customType: "regex",
      managerFilePatterns: ["/rockcraft\\.yaml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s+extractVersion=(?<extractVersion>[^\\n]+)\\n\\s+\\w+_VERSION='(?<currentValue>[^']+)'",
      ],
    },
    {
      // Matches pip install lines annotated with:
      //   # renovate: datasource=pypi
      // Used for Python packages in rockcraft.yaml overlay-scripts
      customType: "regex",
      managerFilePatterns: ["/rockcraft\\.yaml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=pypi\\n\\s+pip install[^\\n]+ (?<depName>[^=\\s]+)==(?<currentValue>[^\\s\\n]+)",
      ],
      datasourceTemplate: "pypi",
    },
    {
      customType: "regex",
      description: "Update Spark tarball version in rockcraft.yaml",
      managerFilePatterns: ["/rockcraft\\.yaml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>[^\\s]+)\\s+depType=(?<depType>[^\\s\\n]+)\\n\\s+source:\\s*https://github\\.com/[^\\s]+/releases/download/(?<currentValue>spark-\\d+\\.\\d+\\.\\d+-ubuntu\\d+)/[^\\s]+\\.tgz",
      ],
      datasourceTemplate: "github-releases",
      versioningTemplate: "regex:^spark-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ubuntu(?<build>\\d+)$",
    },
  ],
  packageRules: [
    {
      // Disallow major updates for jmx_prometheus_javaagent
      matchDepNames: ["io.prometheus.jmx:jmx_prometheus_javaagent"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // Only allow minor and patch updates for jmx_prometheus_javaagent
      matchDepNames: ["io.prometheus.jmx:jmx_prometheus_javaagent"],
      matchUpdateTypes: ["minor", "patch"],
      enabled: true,
    },
    {
      // Only allow minor and patch updates for central-uploader deps
      // depType is captured from the shell variable name in customManagers
      // "canonical/central-uploader"
      matchDatasources: ["github-releases"],
      matchDepNames: ["canonical/central-uploader"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // Only allow minor and patch updates for central-uploader deps
      // depType is captured from the shell variable name in customManagers
      matchDatasources: ["github-releases"],
      matchDepNames: ["canonical/central-uploader"],
      matchUpdateTypes: ["minor", "patch"],
      enabled: true,
    },
    {
      // Only allow patch updates for spark tarball source
      matchDepTypes: ["spark-source"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
  ],
}
